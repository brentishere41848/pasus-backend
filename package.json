{
  "name": "pasus-backend",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "prestart": "npm run build",
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "npm run build && node dist/__tests__/analytics.test.js && node dist/__tests__/otp.test.js",
    "analytics:daily": "tsx src/jobs/analytics.ts daily",
    "analytics:yearly": "tsx src/jobs/analytics.ts yearly",
    "analytics:wrapped": "tsx src/jobs/analytics.ts wrapped",
    "backfill:messages": "tsx scripts/backfill_message_events.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.19.2",
    "mysql2": "^3.9.7",
    "resend": "^3.4.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@vercel/node": "^4.0.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.20.6",
    "typescript": "~5.8.2"
  }
}
